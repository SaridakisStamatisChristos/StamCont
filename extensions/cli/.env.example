# StamCont CLI compatibility environment
#
# Preferred StamCont-prefixed variables take precedence over their Continue-era
# fallbacks when both are provided.

# Remote API base. The compatibility default remains https://api.continue.dev/.
STAMCONT_API_BASE=http://localhost:3001
# CONTINUE_API_BASE=http://localhost:3001

# Optional global state/config directory override.
# If neither variable is set, PR19 intentionally keeps ~/.continue.
# STAMCONT_GLOBAL_DIR=/path/to/stamcont-state
# CONTINUE_GLOBAL_DIR=/path/to/continue-state

# Optional telemetry controls.
# STAMCONT_METRICS_ENABLED=0
# CONTINUE_METRICS_ENABLED=0
# STAMCONT_CLI_ENABLE_TELEMETRY=0
# CONTINUE_CLI_ENABLE_TELEMETRY=0

# Continue API key compatibility surface.
# This is retained until the remote-service migration has its own backend plan.
CONTINUE_API_KEY=
